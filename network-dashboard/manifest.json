{
  "manifest_version": 3,
  "name": "Network Diagnostics Dashboard",
  "version": "2.1.0",
  "description": "Tab-based dashboard for network diagnostics with a modern UI.",
  "permissions": ["tabs", "scripting", "activeTab"],
  "host_permissions": [
    "https://api.ipify.org/*",
    "https://dns.google/*"
  ],
  "web_accessible_resources": [{
    "resources": [
      "modules/web-vitals.js",
      "modules/bandwidth-monitor.js",
      "modules/performance-score.js",
      "modules/waterfall.js",
      "modules/third-party-analyzer.js",
      "modules/recommendations.js"
    ],
    "matches": ["<all_urls>"]
  }],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Diagnostics Dashboard"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
