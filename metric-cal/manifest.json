{
	"manifest_version": 3,
	"name": "Web metrics extension",
	"version": "1.0",
	"description": "Measures web page metrics and track them",
	"permissions": ["tabs", "scripting" ],
	"host_permissions": ["<all_urls>"],
	"action": {
		"default_popup":,
		"default_icon":,
	},
	"background": {
		"service_worker": "background.js"
	}
}